# Monitoring repo MCP integration (example env)

# Netdata parent endpoint
NETDATA_BASE_URL=http://pexnode-netdata.westeurope.azurecontainer.io:19999
NETDATA_API_KEY=

# Pterodactyl
PEXNODE_PANEL_URL=https://panel.pexnode.com
PEXNODE_PTERO_APPLICATION_API_KEY=
PEXNODE_PTERO_CLIENT_API_KEY=

# WHMCS
WHMCS_API_URL=https://billing.pexnode.com/includes/api.php
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=

# Safety gates
MCP_ENABLE_WRITES=true
MCP_ALLOWED_GAMES=minecraft
