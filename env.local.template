# Copy to .env.local and fill in real values.
# .env.local is gitignored. Never commit real credentials.
#
# Full variable reference: pexnode_ops_agent/docs/10-Getting-Started/Env-Variable-Catalog.md

# Netdata Cloud claim token (get from app.netdata.cloud -> Spaces -> Connect Nodes)
NETDATA_CLAIM_TOKEN=
NETDATA_CLAIM_URL=https://app.netdata.cloud


# Streaming API key shared between parent and child agents
NETDATA_API_KEY=pexnode-monitoring-key

# ── Cloud provider API keys (on-demand Wings provisioning) ──────────────────
# Full docs: pexnode_ops_agent/docs/10-Getting-Started/Env-Variable-Catalog.md

# Hetzner Cloud (EU/US/Singapore)
# Get: console.hetzner.cloud -> Project -> Security -> API Tokens (Read+Write)
HETZNER_API_TOKEN=
# Get: Console -> Project -> Security -> SSH Keys (numeric ID in list)
HETZNER_SSH_KEY_ID=

# Vultr (global coverage)
# Get: my.vultr.com/settings/#settingsapi -> Enable API -> copy token
VULTR_API_TOKEN=
# Get: Account -> SSH Keys (UUID shown in list)
VULTR_SSH_KEY_ID=

# ── Ops alert notifications (on-demand node provisioning) ────────────────────
# Who to email when a new region is provisioned (action: order dedicated server)
ALERT_EMAIL=

# SMTP settings for sending alerts (reuse existing cPanel email)
# MAIL_USER and MAIL_PASSWORD should already be set in ~/.config/pexnode/env
MAIL_SMTP_HOST=mail.pexnode.com
MAIL_SMTP_PORT=587

# Optional: Discord or Slack webhook URL for alert messages
# Discord:  Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# Slack:    api.slack.com/messaging/webhooks
ALERT_WEBHOOK_URL=
